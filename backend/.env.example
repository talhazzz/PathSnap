# PathSnap Backend Environment Configuration
# Copy to backend/.env (already excluded by .gitignore) — NEVER commit real keys!

# Optional: Google Gemini API key for AI Route Analyst (POST /ai/explain-trip)
GEMINI_API_KEY=YOUR_KEY_HERE

# Free-tier compatible Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Directory containing the 10 reserved evaluator trips
# PATHSNAP_EVAL_DIR=C:\path\to\evaluator_trips
